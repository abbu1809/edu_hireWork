# =====================================================================
# EduHire Bridge API — environment variables
# ---------------------------------------------------------------------
# 1. Copy this file to  server/.env   (same folder)
# 2. Fill in the values marked REQUIRED
# 3. Run:  npm run dev:server   (from the project root)
#
# server/.env is git-ignored. Never commit real keys.
# =====================================================================


# ---------------------------------------------------------------------
# Server basics
# ---------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Where the React app runs. Used for CORS and for the links in
# Google sign-in / password-reset / email-confirmation redirects.
# Several origins can be comma-separated; the FIRST one is used for redirects.
CLIENT_URL=http://localhost:3000


# ---------------------------------------------------------------------
# Supabase  (REQUIRED — the server will not start without these 3)
# ---------------------------------------------------------------------
# Supabase dashboard → your project → Project Settings → API
#
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# "anon" / "public" key (Project API keys section)
SUPABASE_ANON_KEY=

# "service_role" key — SECRET. Server only. Never put it in client/.env
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------
# Sessions (access token + rotating refresh token stored in the DB)
# ---------------------------------------------------------------------
# Access token  = Supabase JWT (~1 hour), kept in browser memory only.
# Refresh token = random token in an httpOnly cookie; only its SHA-256 hash
#                 is stored in public.user_sessions. Rotates on every refresh.
#
# 32-byte key that encrypts the stored Supabase refresh tokens (AES-256-GCM).
# Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a key is derived from SUPABASE_SERVICE_ROLE_KEY (fine for dev;
# set it in production, or rotating the service key signs everyone out).
TOKEN_ENCRYPTION_KEY=
# How long a login lasts before the user must sign in again.
REFRESH_TOKEN_TTL_DAYS=30
# Cookie settings. Keep "lax" when the client and API share a site — same
# domain, a subdomain (app.x.in + api.x.in), the Vite dev proxy, or a
# host rewrite (/api/* → API). Use "none" only when they are on
# different sites; that requires HTTPS and some browsers block it.
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production.
COOKIE_SECURE=
# Optional: share the cookie across subdomains, e.g. .eduhirebridge.in
COOKIE_DOMAIN=


# ---------------------------------------------------------------------
# Google sign-in (OAuth)
# ---------------------------------------------------------------------
# Google sign-in runs through Supabase Auth, so the API does NOT read these
# two values. They are listed here only so you keep them in one place.
# Paste the same values into:
#   Supabase → Authentication → Sign In / Providers → Google
#
# Get them from: Google Cloud Console → APIs & Services → Credentials →
# edu
#   Authorized redirect URI: https://<your-project>.supabase.co/auth/v1/callback
#
# Also add <CLIENT_URL>/auth/callback under
# Supabase → Authentication → URL Configuration → Redirect URLs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---------------------------------------------------------------------
# Admin account
# ---------------------------------------------------------------------
# The single platform administrator. Register once on the site with this
# email (or sign in with Google using it) to create the admin account.
ADMIN_EMAIL=admin@eduhirebridge.in


# ---------------------------------------------------------------------
# Razorpay  (optional — needed only to test "Unlock Contact" payments)
# ---------------------------------------------------------------------
# Razorpay dashboard → switch to TEST MODE → Account & Settings → API Keys
# → Generate Key. Test keys start with rzp_test_ and move no real money.
# Test card: 4111 1111 1111 1111, any future expiry, any CVV, OTP 1234 (or use UPI id success@razorpay).
# Leave blank to disable payments (the unlock button then says
# "payments are not configured").
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional for local testing. Razorpay → Account & Settings → Webhooks →
# Add webhook URL  https://<your-public-server>/api/payments/webhook
# with events payment.captured, order.paid, payment.failed, then paste
# the secret you chose here. (Webhooks need a public URL, e.g. via ngrok.)
RAZORPAY_WEBHOOK_SECRET=


# ---------------------------------------------------------------------
# Pricing (INR)
# ---------------------------------------------------------------------
INSTITUTE_UNLOCK_FEE=499


# ---------------------------------------------------------------------
# Email — Nodemailer SMTP (OTP codes, welcome, job alerts, receipts,
# admin broadcasts). Leave blank in development: every email is then
# printed to the server console (so you can read OTP codes there).
# ---------------------------------------------------------------------
# Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#          SMTP_USER=you@gmail.com   SMTP_PASS=<16-char App Password>
#          (Google Account → Security → 2-Step Verification → App passwords)
# Zoho:    smtp.zoho.in : 587      Brevo: smtp-relay.brevo.com : 587
# AWS SES: email-smtp.<region>.amazonaws.com : 587 (SMTP credentials)
SMTP_HOST=
SMTP_PORT=587
# true only for port 465 (implicit TLS). Auto-detected from the port if omitted.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Sender shown in the inbox. Use an address on a domain you've verified
# with your provider (SPF/DKIM) or mail may land in spam.
FROM_EMAIL=no-reply@eduhirebridge.in
FROM_NAME=EduHire Bridge
# Optional: where replies go (e.g. support@eduhirebridge.in)
REPLY_TO_EMAIL=

# Receives a copy of every contact-form inquiry (defaults to ADMIN_EMAIL).
ADMIN_NOTIFY_EMAIL=

# Email OTP for sign-up: on by default. Set to false to use Supabase's own
# confirmation emails instead.
REQUIRE_SIGNUP_OTP=true
# Minutes before a code expires
OTP_TTL_MINUTES=10
# Optional secret used to hash OTP codes (defaults to a hash of the service key)
OTP_SECRET=
