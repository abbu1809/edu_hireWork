# =====================================================================
# EduHire Bridge client — environment variables
# ---------------------------------------------------------------------
# For LOCAL TESTING you don't need a client/.env at all: the defaults
# below already work. Copy this file to client/.env only to change them.
#
# Only public values go here — everything in a VITE_ variable is bundled
# into the browser JavaScript. No Supabase or Razorpay secrets, ever.
# (The Razorpay key id is sent to the browser by the server at checkout.)
# =====================================================================

# Base URL of the EduHire API.
# Development: keep /api — the Vite dev server forwards it to the Express server.
# Production: the deployed server, e.g. https://api.eduhirebridge.in/api
VITE_API_URL=/api

# Development only: where the Vite dev server forwards /api.
# Change it if you run the server on a different port.
VITE_DEV_API_PROXY=http://localhost:5000
